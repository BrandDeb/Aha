# Copy to .env.local — every value is optional for local use.

# The assistant works without any of these: each user picks a free provider
# (Gemini, Groq, OpenRouter, Cerebras, Mistral, Ollama, LM Studio) or their own
# key in the assistant panel. Set this only to offer a hosted default.
# ANTHROPIC_API_KEY=

# GitHub sign-in: an OAuth app's client ID is enough (tick "Enable Device Flow" in its settings);
# add the secret and redirect URI only for the redirect flow on a host with a fixed address
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Google sign-in: an OAuth client of type "TVs and Limited Input devices" (no domain needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Signs the account cookie. Unset: a key is made once and kept in ~/.aha/session-secret
# AHA_SESSION_SECRET=

# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# PORT=3000
