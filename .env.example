# Copy to .env.local — every value is optional for local use.

# The assistant works without any of these: each user picks a free provider
# (Gemini, Groq, OpenRouter, Cerebras, Mistral, Ollama, LM Studio) or their own
# key in the assistant panel. Set this only to offer a hosted default.
# ANTHROPIC_API_KEY=

# GitHub sign-in (OAuth app callback: http://localhost:3000/api/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# PORT=3000
