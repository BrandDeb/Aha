{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoCLI Studio",
  "version": "1.0.0",
  "identifier": "dev.nanocli.studio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The IDE where AI does the work and proves it",
    "longDescription": "An editor and an AI teammate in one workspace: proposals with evidence, an autonomous worker, debugging on autopilot, 40+ languages and field kits, with your own model.",
    "copyright": "© 2026 BrandDeb. All rights reserved.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../desktop/app/": "app/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
