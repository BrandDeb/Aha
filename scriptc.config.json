{
  "$schema": "https://raw.githubusercontent.com/ctate/scriptc/main/packages/scriptc/schema.json",
  "name": "nano-cli-studio",
  "version": "0.1.0",
  "description": "Edge-optimized CLI studio with scriptc",
  "targets": [
    {
      "name": "wasm",
      "type": "wasm",
      "entrypoint": "src/edge/index.ts",
      "outDir": "dist/wasm",
      "minify": true,
      "sourcemap": true
    },
    {
      "name": "native",
      "type": "binary",
      "entrypoint": "src/edge/index.ts",
      "outDir": "dist/native",
      "minify": true,
      "platform": "linux",
      "arch": "x64"
    }
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
