 "source": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\ncontract Counter {\n    error TooBig(uint256 value, uint256 max);\n    event Changed(address indexed by, uint256 value);\n    uint256 public count;\n    address public owner;\n    constructor(uint256 start) payable { count = start; owner = msg.sender; }\n    function add(uint256 n) external { if (count + n > 100) revert TooBig(count + n, 100); count += n; emit Changed(msg.sender, count); }\n    function onlyOwnerReset() external { require(msg.sender == owner, \"not the owner\"); count = 0; }\n    function divide(uint256 d) external view returns (uint256) { return count / d; }\n    function deposit() external payable {}\n    function info() external view returns (uint256, address) { return (count, owner); }\n}",
