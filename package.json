{
  "name": "aha",
  "version": "1.0.0",
  "description": "Zero-Runtime TypeScript CLI Generator - Write TypeScript, Get Native Binaries",
  "private": true,
  "scripts": {
    "dev": "node scripts/supervise.js",
    "prebuild": "node scripts/build-docs.mjs",
    "docs:sync": "node scripts/build-docs.mjs",
    "build": "next build",
    "start": "node scripts/supervise.js",
    "start:plain": "node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.ts'",
    "templates:build": "node --experimental-strip-types scripts/build-templates.ts",
    "templates:wasm": "node --experimental-strip-types scripts/build-templates.ts --wasm",
    "clean": "rm -rf temp .next dist",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "verify:templates": "node --experimental-strip-types scripts/verify-templates.ts",
    "verify:apps": "node --experimental-strip-types --no-warnings scripts/verify-apps.ts",
    "verify:stacks": "node --experimental-strip-types scripts/verify-stacks.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@monaco-editor/loader": "^1.7.0",
    "@scriptc/runtime-wasm32-wasi": "^0.2.2",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "js-yaml": "^4.3.2",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scriptc": "^0.2.2",
    "typescript": "^5",
    "viem": "^2.57.10",
    "wabt": "^1.0.39",
    "websocket": "^1.0.34"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/websocket": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "typescript",
    "compiler",
    "native",
    "wasm",
    "cli",
    "scriptc",
    "edge",
    "zero-runtime"
  ],
  "author": "",
  "license": "UNLICENSED",
  "optionalDependencies": {
    "@zigc/darwin-arm64": "0.17.0",
    "@zigc/darwin-x64": "0.17.0",
    "@zigc/lib": "0.17.0",
    "@zigc/linux-arm64": "0.17.0",
    "@zigc/linux-x64": "0.17.0",
    "@zigc/win32-arm64": "0.17.0",
    "@zigc/win32-x64": "0.17.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
