{
  "name": "nano-cli-studio",
  "version": "1.0.0",
  "description": "Zero-Runtime TypeScript CLI Generator - Write TypeScript, Get Native Binaries",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "scriptc:build": "scriptc build",
    "scriptc:dev": "scriptc dev",
    "scriptc:wasm": "scriptc build --target wasm",
    "scriptc:native": "scriptc build --target binary",
    "clean": "rm -rf temp node_modules/.next",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "websocket": "^1.0.34",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "cookie-parser": "^1.4.6",
    "body-parser": "^1.20.2",
    "uuid": "^9.0.0",
    "@octokit/core": "^5.0.0",
    "@octokit/oauth-app": "^6.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@scriptc/compiler": "^0.2.0",
    "@scriptc/runtime": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.7",
    "@types/body-parser": "^1.19.5",
    "@types/websocket": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "scriptc": "^0.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "typescript",
    "compiler",
    "native",
    "wasm",
    "cli",
    "scriptc",
    "edge",
    "zero-runtime"
  ],
  "author": "",
  "license": "MIT"
}
